#!/bin/sh
# Repo Starter convention v1: no direct pushes to main. Every change arrives through a pull request.
# Set REPO_STARTER_ALLOW_MAIN=1 in the shell for the one push you mean, for example the very first one.
branch="main"
[ -n "$REPO_STARTER_ALLOW_MAIN" ] && exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/$branch" ]; then
    echo "pre-push: refusing to push to $branch; open a pull request from a branch instead" >&2
    echo "pre-push: to push anyway, set REPO_STARTER_ALLOW_MAIN=1 for this one command" >&2
    exit 1
  fi
done
exit 0
